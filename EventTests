using System.Net;
using System.Net.Http.Json;
using RaceDay.Api.Dtos;
 
namespace RaceDay.Tests;
 
/// <summary>Event and category management: Organisers can manage them, everyone can view them.</summary>
public class EventTests : IClassFixture<ApiFactory>
{
    private readonly ApiFactory _factory;
    public EventTests(ApiFactory factory) => _factory = factory;
 
    private static EventUpdateRequest NewUpdate() => new()
    {
        Name = "Renamed Event",
        Description = "Updated description",
        EventType = "Cycle",
        Location = "Cape Town",
        Date = new DateOnly(2026, 12, 1),
        Time = new TimeOnly(7, 0),
        Distance = 42.2m
    };
 
    // ---------- Organiser success scenarios ----------
 
    [Fact]
    public async Task Organiser_CanCreateEvent_Returns201WithEventDetailsAndRoute()
    {
        var (organiser, auth) = await TestHelpers.LoginAsync(_factory, "Organiser");
 
        var response = await organiser.PostAsJsonAsync("/api/events", TestHelpers.NewEventRequest("Walk", "Park Walk"));
 
        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
        var ev = await response.Content.ReadFromJsonAsync<EventResponse>();
        Assert.Equal("Park Walk", ev!.Name);
        Assert.Equal("Walk", ev.EventType);
        Assert.Equal(auth.ProfileId, ev.OrganiserId);
        Assert.NotNull(ev.Route);
        Assert.Equal(10m, ev.Route!.Distance);
    }
 
    [Fact]
    public async Task Organiser_CanUpdateOwnEvent_Returns200()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var ev = await TestHelpers.CreateEventAsync(organiser);
 
        var response = await organiser.PutAsJsonAsync($"/api/events/{ev.EventId}", NewUpdate());
 
        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
        var updated = await response.Content.ReadFromJsonAsync<EventResponse>();
        Assert.Equal("Renamed Event", updated!.Name);
        Assert.Equal("Cycle", updated.EventType);
        Assert.Equal(42.2m, updated.Route!.Distance);
    }
 
    [Fact]
    public async Task Organiser_CanDeleteOwnEvent_ThenItIsGone()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var ev = await TestHelpers.CreateEventAsync(organiser);
 
        var delete = await organiser.DeleteAsync($"/api/events/{ev.EventId}");
        var get = await organiser.GetAsync($"/api/events/{ev.EventId}");
 
        Assert.Equal(HttpStatusCode.OK, delete.StatusCode);
        Assert.Equal(HttpStatusCode.NotFound, get.StatusCode);
    }
 
    [Fact]
    public async Task Organiser_CanDefineCategories_AndTheyAreListed()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        await TestHelpers.CreateCategoryAsync(organiser, ev.EventId, name: "10km");
        await TestHelpers.CreateCategoryAsync(organiser, ev.EventId, name: "Under 20");
 
        var response = await organiser.GetAsync($"/api/events/{ev.EventId}/categories");
 
        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
        var list = await response.Content.ReadFromJsonAsync<List<CategoryResponse>>();
        Assert.Equal(2, list!.Count);
    }
 
    [Fact]
    public async Task Organiser_CanUpdateAndDeleteOwnCategory()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        var category = await TestHelpers.CreateCategoryAsync(organiser, ev.EventId);
 
        var update = await organiser.PutAsJsonAsync($"/api/categories/{category.CategoryId}",
            new CategoryRequest { CategoryName = "21km", EntryFee = 250m, MaxParticipants = 100 });
        var delete = await organiser.DeleteAsync($"/api/categories/{category.CategoryId}");
 
        Assert.Equal(HttpStatusCode.OK, update.StatusCode);
        Assert.Equal(HttpStatusCode.OK, delete.StatusCode);
    }
 
    // ---------- Viewing (both roles and anonymous) ----------
 
    [Fact]
    public async Task Anyone_CanViewEvents_AndFilterByType()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var ev = await TestHelpers.CreateEventAsync(organiser, "Cycle", "Tour Test");
        var anonymous = _factory.CreateClient();
 
        var all = await anonymous.GetAsync("/api/events");
        var cycleOnly = await anonymous.GetAsync("/api/events?type=Cycle");
        var single = await anonymous.GetAsync($"/api/events/{ev.EventId}");
 
        Assert.Equal(HttpStatusCode.OK, all.StatusCode);
        var cycles = await cycleOnly.Content.ReadFromJsonAsync<List<EventResponse>>();
        Assert.Contains(cycles!, e => e.EventId == ev.EventId);
        Assert.All(cycles!, e => Assert.Equal("Cycle", e.EventType));
        Assert.Equal(HttpStatusCode.OK, single.StatusCode);
    }
 
    [Fact]
    public async Task Participant_CanViewEventsAndCategories()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        await TestHelpers.CreateCategoryAsync(organiser, ev.EventId);
        var (participant, _) = await TestHelpers.LoginAsync(_factory, "Participant");
 
        var events = await participant.GetAsync("/api/events");
        var categories = await participant.GetAsync($"/api/events/{ev.EventId}/categories");
 
        Assert.Equal(HttpStatusCode.OK, events.StatusCode);
        Assert.Equal(HttpStatusCode.OK, categories.StatusCode);
    }
 
    [Fact]
    public async Task GetEvent_Unknown_Returns404()
    {
        var response = await _factory.CreateClient().GetAsync("/api/events/999999");
 
        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
    }
 
    // ---------- Failure scenarios ----------
 
    [Fact]
    public async Task CreateEvent_InvalidEventType_Returns400()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
 
        var response = await organiser.PostAsJsonAsync("/api/events", TestHelpers.NewEventRequest("Swim"));
 
        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
    }
 
    [Fact]
    public async Task CreateEvent_WithoutLogin_Returns401()
    {
        var response = await _factory.CreateClient().PostAsJsonAsync("/api/events", TestHelpers.NewEventRequest());
 
        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
    }
 
    [Fact]
    public async Task Organiser_CannotUpdateAnotherOrganisersEvent_Returns403()
    {
        var (owner, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (other, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var ev = await TestHelpers.CreateEventAsync(owner);
 
        var response = await other.PutAsJsonAsync($"/api/events/{ev.EventId}", NewUpdate());
 
        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);
    }
 
    [Fact]
    public async Task Organiser_CannotDeleteAnotherOrganisersEvent_Returns403()
    {
        var (owner, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (other, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var ev = await TestHelpers.CreateEventAsync(owner);
 
        var response = await other.DeleteAsync($"/api/events/{ev.EventId}");
 
        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);
    }
 
    [Fact]
    public async Task Organiser_CannotAddCategoryToAnotherOrganisersEvent_Returns403()
    {
        var (owner, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (other, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var ev = await TestHelpers.CreateEventAsync(owner);
 
        var response = await other.PostAsJsonAsync($"/api/events/{ev.EventId}/categories",
            new CategoryRequest { CategoryName = "Sneaky", EntryFee = 0m });
 
        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);
    }
 
    [Fact]
    public async Task Category_CannotBeDeleted_WhenParticipantsAreRegistered_Returns409()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (participant, _) = await TestHelpers.LoginAsync(_factory, "Participant");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        var category = await TestHelpers.CreateCategoryAsync(organiser, ev.EventId);
        await TestHelpers.EnrolAsync(participant, category.CategoryId);
 
        var response = await organiser.DeleteAsync($"/api/categories/{category.CategoryId}");
 
        Assert.Equal(HttpStatusCode.Conflict, response.StatusCode);
    }
}
 
