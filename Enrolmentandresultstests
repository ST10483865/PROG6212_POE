using System.Net;
using System.Net.Http.Json;
using RaceDay.Api.Dtos;
 
namespace RaceDay.Tests;
 
/// <summary>Event enrolments (Participant -> Category -> Event) and result capture.</summary>
public class EnrolmentAndResultTests : IClassFixture<ApiFactory>
{
    private readonly ApiFactory _factory;
    public EnrolmentAndResultTests(ApiFactory factory) => _factory = factory;
 
    // ---------- Enrolments ----------
 
    [Fact]
    public async Task Participant_CanEnrol_Returns201WithRaceNumber()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (participant, auth) = await TestHelpers.LoginAsync(_factory, "Participant");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        var category = await TestHelpers.CreateCategoryAsync(organiser, ev.EventId);
 
        var response = await participant.PostAsJsonAsync("/api/registrations", new RegistrationRequest { CategoryId = category.CategoryId });
 
        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
        var registration = await response.Content.ReadFromJsonAsync<RegistrationResponse>();
        Assert.Equal(auth.ProfileId, registration!.ParticipantId);
        Assert.Equal(category.CategoryId, registration.CategoryId);
        Assert.Equal(ev.EventId, registration.EventId);
        Assert.False(string.IsNullOrWhiteSpace(registration.RaceNum));
    }
 
    [Fact]
    public async Task Enrolment_IsRecorded_ParticipantAndOrganiserBothSeeIt()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (participant, auth) = await TestHelpers.LoginAsync(_factory, "Participant");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        var category = await TestHelpers.CreateCategoryAsync(organiser, ev.EventId);
        var registration = await TestHelpers.EnrolAsync(participant, category.CategoryId);
 
        var mine = await participant.GetFromJsonAsync<List<RegistrationResponse>>($"/api/participants/{auth.ProfileId}/registrations");
        var forEvent = await organiser.GetFromJsonAsync<List<RegistrationResponse>>($"/api/events/{ev.EventId}/registrations");
        var single = await participant.GetAsync($"/api/registrations/{registration.RegistrationId}");
 
        Assert.Contains(mine!, r => r.RegistrationId == registration.RegistrationId);
        Assert.Contains(forEvent!, r => r.RegistrationId == registration.RegistrationId && r.ParticipantId == auth.ProfileId);
        Assert.Equal(HttpStatusCode.OK, single.StatusCode);
    }
 
    [Fact]
    public async Task Enrol_SameEventTwice_Returns409()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (participant, _) = await TestHelpers.LoginAsync(_factory, "Participant");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        var tenK = await TestHelpers.CreateCategoryAsync(organiser, ev.EventId, name: "10km");
        var fiveK = await TestHelpers.CreateCategoryAsync(organiser, ev.EventId, name: "5km");
        await TestHelpers.EnrolAsync(participant, tenK.CategoryId);
 
        var second = await participant.PostAsJsonAsync("/api/registrations", new RegistrationRequest { CategoryId = fiveK.CategoryId });
 
        Assert.Equal(HttpStatusCode.Conflict, second.StatusCode);
    }
 
    [Fact]
    public async Task Enrol_FullCategory_Returns409()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (first, _) = await TestHelpers.LoginAsync(_factory, "Participant");
        var (second, _) = await TestHelpers.LoginAsync(_factory, "Participant");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        var category = await TestHelpers.CreateCategoryAsync(organiser, ev.EventId, max: 1);
        await TestHelpers.EnrolAsync(first, category.CategoryId);
 
        var response = await second.PostAsJsonAsync("/api/registrations", new RegistrationRequest { CategoryId = category.CategoryId });
 
        Assert.Equal(HttpStatusCode.Conflict, response.StatusCode);
    }
 
    [Fact]
    public async Task Enrol_UnknownCategory_Returns404()
    {
        var (participant, _) = await TestHelpers.LoginAsync(_factory, "Participant");
 
        var response = await participant.PostAsJsonAsync("/api/registrations", new RegistrationRequest { CategoryId = 999999 });
 
        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
    }
 
    [Fact]
    public async Task Enrol_ForAnotherParticipantId_Returns403()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (participant, auth) = await TestHelpers.LoginAsync(_factory, "Participant");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        var category = await TestHelpers.CreateCategoryAsync(organiser, ev.EventId);
 
        var response = await participant.PostAsJsonAsync("/api/registrations",
            new RegistrationRequest { CategoryId = category.CategoryId, ParticipantId = auth.ProfileId + 1000 });
 
        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);
    }
 
    [Fact]
    public async Task Participant_CanWithdraw_Returns200()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (participant, _) = await TestHelpers.LoginAsync(_factory, "Participant");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        var category = await TestHelpers.CreateCategoryAsync(organiser, ev.EventId);
        var registration = await TestHelpers.EnrolAsync(participant, category.CategoryId);
 
        var delete = await participant.DeleteAsync($"/api/registrations/{registration.RegistrationId}");
        var get = await participant.GetAsync($"/api/registrations/{registration.RegistrationId}");
 
        Assert.Equal(HttpStatusCode.OK, delete.StatusCode);
        Assert.Equal(HttpStatusCode.NotFound, get.StatusCode);
    }
 
    [Fact]
    public async Task Participant_CannotWithdrawAnotherParticipantsRegistration_Returns403()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (owner, _) = await TestHelpers.LoginAsync(_factory, "Participant");
        var (other, _) = await TestHelpers.LoginAsync(_factory, "Participant");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        var category = await TestHelpers.CreateCategoryAsync(organiser, ev.EventId);
        var registration = await TestHelpers.EnrolAsync(owner, category.CategoryId);
 
        var response = await other.DeleteAsync($"/api/registrations/{registration.RegistrationId}");
 
        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);
    }
 
    // ---------- Results ----------
 
    [Fact]
    public async Task Organiser_CanCaptureResult_ParticipantSeesOwnResult()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (participant, auth) = await TestHelpers.LoginAsync(_factory, "Participant");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        var category = await TestHelpers.CreateCategoryAsync(organiser, ev.EventId);
        var registration = await TestHelpers.EnrolAsync(participant, category.CategoryId);
 
        var capture = await organiser.PostAsJsonAsync("/api/results",
            new ResultRequest { RegistrationId = registration.RegistrationId, FinishTime = new TimeSpan(0, 52, 30), Position = 3 });
        var mine = await participant.GetFromJsonAsync<List<ResultResponse>>($"/api/participants/{auth.ProfileId}/results");
 
        Assert.Equal(HttpStatusCode.Created, capture.StatusCode);
        var result = Assert.Single(mine!);
        Assert.Equal(3, result.Position);
        Assert.Equal(new TimeSpan(0, 52, 30), result.FinishTime);
    }
 
    [Fact]
    public async Task CaptureResult_TwiceForSameRegistration_Returns409()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (participant, _) = await TestHelpers.LoginAsync(_factory, "Participant");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        var category = await TestHelpers.CreateCategoryAsync(organiser, ev.EventId);
        var registration = await TestHelpers.EnrolAsync(participant, category.CategoryId);
        var body = new ResultRequest { RegistrationId = registration.RegistrationId, FinishTime = TimeSpan.FromMinutes(45), Position = 1 };
        (await organiser.PostAsJsonAsync("/api/results", body)).EnsureSuccessStatusCode();
 
        var second = await organiser.PostAsJsonAsync("/api/results", body);
 
        Assert.Equal(HttpStatusCode.Conflict, second.StatusCode);
    }
 
    [Fact]
    public async Task CaptureResult_UnknownRegistration_Returns404()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
 
        var response = await organiser.PostAsJsonAsync("/api/results",
            new ResultRequest { RegistrationId = 999999, FinishTime = TimeSpan.FromMinutes(45) });
 
        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
    }
 
    [Fact]
    public async Task Leaderboard_IsPublic_AndOrderedByPosition()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (p1, _) = await TestHelpers.LoginAsync(_factory, "Participant");
        var (p2, _) = await TestHelpers.LoginAsync(_factory, "Participant");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        var category = await TestHelpers.CreateCategoryAsync(organiser, ev.EventId);
        var r1 = await TestHelpers.EnrolAsync(p1, category.CategoryId);
        var r2 = await TestHelpers.EnrolAsync(p2, category.CategoryId);
        // Capture second place first, to prove the endpoint sorts rather than returning insertion order.
        (await organiser.PostAsJsonAsync("/api/results", new ResultRequest { RegistrationId = r1.RegistrationId, FinishTime = TimeSpan.FromMinutes(61), Position = 2 })).EnsureSuccessStatusCode();
        (await organiser.PostAsJsonAsync("/api/results", new ResultRequest { RegistrationId = r2.RegistrationId, FinishTime = TimeSpan.FromMinutes(55), Position = 1 })).EnsureSuccessStatusCode();
 
        var board = await _factory.CreateClient().GetFromJsonAsync<List<ResultResponse>>($"/api/events/{ev.EventId}/results");
 
        Assert.Equal(new[] { 1, 2 }, board!.Select(r => r.Position!.Value).ToArray());
    }
 
    [Fact]
    public async Task Organiser_CanCorrectResult_Returns200()
    {
        var (organiser, _) = await TestHelpers.LoginAsync(_factory, "Organiser");
        var (participant, _) = await TestHelpers.LoginAsync(_factory, "Participant");
        var ev = await TestHelpers.CreateEventAsync(organiser);
        var category = await TestHelpers.CreateCategoryAsync(organiser, ev.EventId);
        var registration = await TestHelpers.EnrolAsync(participant, category.CategoryId);
        var created = await (await organiser.PostAsJsonAsync("/api/results",
            new ResultRequest { RegistrationId = registration.RegistrationId, FinishTime = TimeSpan.FromMinutes(70), Position = 5 }))
            .Content.ReadFromJsonAsync<ResultResponse>();
 
        var response = await organiser.PutAsJsonAsync($"/api/results/{created!.ResultId}",
            new ResultUpdateRequest { FinishTime = TimeSpan.FromMinutes(68), Position = 4 });
 
        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
        var updated = await response.Content.ReadFromJsonAsync<ResultResponse>();
        Assert.Equal(4, updated!.Position);
    }
}
 
