@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        @if (!string.IsNullOrEmpty(Model.ReturnUrl))
        {
            <div class="alert alert-info"><i class="bi bi-info-circle-fill"></i> Please log in to continue.</div>
        }
        <div class="card auth-card">
            <div class="card-body p-4 p-md-5">
                <h1 class="page-title">Welcome back</h1>
                <p class="text-muted">Log in to manage or enter events.</p>

                <form asp-action="Login" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Log in</button>
                </form>

                <p class="text-center mt-4 mb-0">New to RaceDay? <a href="/Account/Register">Create an account</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

