@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card auth-card">
            <div class="card-body p-4 p-md-5">
                <h1 class="page-title">Join RaceDay</h1>
                <p class="text-muted">Create your account and choose how you will use RaceDay.</p>

                <form asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <label class="form-label">I am an...</label>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <input type="radio" class="btn-check" asp-for="Role" value="Participant" id="roleParticipant" />
                            <label class="role-option" for="roleParticipant">
                                <i class="bi bi-person-running"></i>
                                <strong>Participant</strong>
                                <small>Enter events and track my results</small>
                            </label>
                        </div>
                        <div class="col-6">
                            <input type="radio" class="btn-check" asp-for="Role" value="Organiser" id="roleOrganiser" />
                            <label class="role-option" for="roleOrganiser">
                                <i class="bi bi-megaphone"></i>
                                <strong>Organiser</strong>
                                <small>Create and manage events</small>
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="Role" class="text-danger small"></span>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" autocomplete="name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label"></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">Select...</option>
                                <option>Female</option>
                                <option>Male</option>
                                <option>Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Contact" class="form-label"></label>
                            <input asp-for="Contact" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="Contact" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-12" id="organiserFields">
                            <label asp-for="ClubName" class="form-label"></label>
                            <input asp-for="ClubName" class="form-control" placeholder="e.g. Joburg Road Runners" />
                            <span asp-validation-for="ClubName" class="text-danger small"></span>
                        </div>
                        <div class="col-12" id="participantFields">
                            <label asp-for="MedicalInfo" class="form-label"></label>
                            <input asp-for="MedicalInfo" class="form-control" placeholder="Allergies or conditions the organiser should know about" />
                            <span asp-validation-for="MedicalInfo" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-4">Create account</button>
                </form>

                <p class="text-center mt-4 mb-0">Already registered? <a href="/Account/Login">Log in</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show only the fields that belong to the chosen role
        function updateRoleFields() {
            var isOrganiser = document.getElementById('roleOrganiser').checked;
            document.getElementById('organiserFields').style.display = isOrganiser ? '' : 'none';
            document.getElementById('participantFields').style.display = isOrganiser ? 'none' : '';
        }
        document.getElementById('roleOrganiser').addEventListener('change', updateRoleFields);
        document.getElementById('roleParticipant').addEventListener('change', updateRoleFields);
        updateRoleFields();
    </script>
}
