using System.Net.Http.Json;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Mvc.Testing;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.DependencyInjection;
using RaceDay.Api.Data;
using RaceDay.Api.Dtos;
 
namespace RaceDay.Tests;
 
/// <summary>
/// Starts the real API in memory for each test class, but swaps SQL Server for an in-memory database
/// so the tests run anywhere (including GitHub Actions) with no SQL Server installed.
/// The real cookie login, role checks and controllers are all exercised.
/// </summary>
public class ApiFactory : WebApplicationFactory<Program>
{
    private readonly string _dbName = $"RaceDayTests-{Guid.NewGuid()}";
 
    protected override void ConfigureWebHost(IWebHostBuilder builder)
    {
        builder.UseEnvironment("Testing");
        builder.ConfigureServices(services =>
        {
            // Remove every registration tied to the SQL Server DbContext configuration.
            var toRemove = services.Where(d =>
                d.ServiceType == typeof(DbContextOptions<RaceDayDbContext>) ||
                d.ServiceType == typeof(DbContextOptions) ||
                (d.ServiceType.IsGenericType && d.ServiceType.GenericTypeArguments.Contains(typeof(RaceDayDbContext))))
                .ToList();
            foreach (var d in toRemove) services.Remove(d);
 
            services.AddDbContext<RaceDayDbContext>(o => o.UseInMemoryDatabase(_dbName));
        });
    }
}
 
public static class TestHelpers
{
    public const string Password = "Passw0rd!123";
 
    public static string UniqueEmail() => $"{Guid.NewGuid():N}@raceday.test";
 
    /// <summary>Registers a new user with the given role, logs in, and returns a client that holds the session cookie.</summary>
    public static async Task<(HttpClient Client, AuthResponse Auth)> LoginAsync(ApiFactory factory, string role)
    {
        var client = factory.CreateClient();
        var email = UniqueEmail();
 
        var register = await client.PostAsJsonAsync("/api/auth/register", new RegisterRequest
        {
            Name = $"Test {role}",
            Email = email,
            Password = Password,
            Gender = "Female",
            Role = role,
            ClubName = role == "Organiser" ? "Test Club" : null
        });
        register.EnsureSuccessStatusCode();
 
        var login = await client.PostAsJsonAsync("/api/auth/login", new LoginRequest { Email = email, Password = Password });
        login.EnsureSuccessStatusCode();
        var auth = (await login.Content.ReadFromJsonAsync<AuthResponse>())!;
        return (client, auth);
    }
 
    public static EventRequest NewEventRequest(string type = "Run", string name = "Test Event") => new()
    {
        Name = name,
        Description = "A test event",
        EventType = type,
        Location = "Johannesburg CBD",
        Date = new DateOnly(2026, 11, 15),
        Time = new TimeOnly(6, 30),
        StartingPoint = "Start line",
        EndingPoint = "Finish line",
        Distance = 10m
    };
 
    public static async Task<EventResponse> CreateEventAsync(HttpClient organiser, string type = "Run", string name = "Test Event")
    {
        var response = await organiser.PostAsJsonAsync("/api/events", NewEventRequest(type, name));
        response.EnsureSuccessStatusCode();
        return (await response.Content.ReadFromJsonAsync<EventResponse>())!;
    }
 
    public static async Task<CategoryResponse> CreateCategoryAsync(HttpClient organiser, int eventId, int? max = null, string name = "10km")
    {
        var response = await organiser.PostAsJsonAsync($"/api/events/{eventId}/categories",
            new CategoryRequest { CategoryName = name, EntryFee = 150m, MaxParticipants = max });
        response.EnsureSuccessStatusCode();
        return (await response.Content.ReadFromJsonAsync<CategoryResponse>())!;
    }
 
    public static async Task<RegistrationResponse> EnrolAsync(HttpClient participant, int categoryId)
    {
        var response = await participant.PostAsJsonAsync("/api/registrations", new RegistrationRequest { CategoryId = categoryId });
        response.EnsureSuccessStatusCode();
        return (await response.Content.ReadFromJsonAsync<RegistrationResponse>())!;
    }
}
